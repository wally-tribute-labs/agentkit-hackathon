# Default: deterministic public demo. No credentials or database required.
GROUNDSIGNAL_MODE=demo
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Single-instance local or Docker self-hosting only.
# GROUNDSIGNAL_MODE=sqlite
# GROUNDSIGNAL_DB_PATH=./data/groundsignal.db
# OBSERVER_SESSION_SECRET=replace-with-at-least-32-random-bytes

# Optional World ID 4 integration (SQLite mode).
# WORLD_ID_APP_ID=app_xxxxx
# WORLD_ID_RP_ID=rp_xxxxx
# WORLD_ID_RP_SIGNING_KEY=0x...

# Optional x402 Base Sepolia integration. No defaults are supplied intentionally.
# X402_FACILITATOR_URL=https://x402.org/facilitator
# X402_NETWORK=eip155:84532
# X402_PAY_TO=0x...

# Optional AgentKit hooks (SQLite mode only).
# AGENTKIT_ENABLED=true
# WORLD_CHAIN_RPC_URL=https://...

# Optional standalone XMTP process.
# GROUNDSIGNAL_API_URL=http://localhost:3000
# GROUNDSIGNAL_XMTP_MODE=demo
# AGENT_PRIVATE_KEY=0x... # Base Sepolia buyer key; required only in integration mode
# XMTP_WALLET_KEY=...
# XMTP_DB_ENCRYPTION_KEY=...
